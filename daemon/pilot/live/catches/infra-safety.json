{
  "name": "infra-safety",
  "title": "Commands that destroy infrastructure",
  "author": "Heliox",
  "license": "Apache-2.0",
  "rules": [
    {
      "id": "kubectl-delete-namespace",
      "where": ["terminal"],
      "pattern": "\\bkubectl\\s+delete\\s+(?:ns|namespaces?)\\b",
      "flags": "i",
      "title": "That deletes a whole namespace",
      "message": "Everything in it goes too, so check your kubectl context first.",
      "urgency": "urgent",
      "positives": ["kubectl delete namespace staging", "kubectl delete ns payments", "$ kubectl delete namespaces old-team"],
      "decoys": ["kubectl get namespaces", "kubectl delete pod api-7f9c -n staging", "kubectl describe ns payments"]
    },
    {
      "id": "terraform-destroy",
      "where": ["terminal"],
      "pattern": "\\bterraform\\s+(?:apply\\s+-destroy|destroy)\\b(?![^\\n]*-target)",
      "flags": "i",
      "title": "That destroys every resource in the state",
      "message": "Run terraform plan -destroy first to see the list.",
      "urgency": "urgent",
      "positives": ["terraform destroy", "terraform destroy -auto-approve", "terraform apply -destroy"],
      "decoys": ["terraform destroy -target=aws_instance.web", "terraform plan -destroy", "terraform apply"]
    },
    {
      "id": "docker-prune-volumes",
      "where": ["terminal"],
      "pattern": "\\bdocker\\s+(?:system\\s+prune\\b[^\\n]*--volumes|volume\\s+prune\\b)",
      "flags": "i",
      "title": "That deletes Docker volumes",
      "message": "Unused volumes go too, databases included.",
      "urgency": "urgent",
      "positives": ["docker system prune -a --volumes", "docker volume prune", "docker system prune --volumes -f"],
      "decoys": ["docker system prune", "docker volume ls", "docker image prune -a"]
    },
    {
      "id": "s3-recursive-delete",
      "where": ["terminal"],
      "pattern": "\\baws\\s+s3\\s+(?:rm\\s+s3://\\S+[^\\n]*--recursive|rb\\s+s3://\\S+[^\\n]*--force)",
      "flags": "i",
      "title": "That empties an S3 bucket",
      "message": "S3 has no undo unless versioning is on.",
      "urgency": "urgent",
      "positives": ["aws s3 rm s3://prod-assets --recursive", "aws s3 rb s3://old-logs --force", "aws s3 rm s3://backups/2026/ --recursive --quiet"],
      "decoys": ["aws s3 ls s3://prod-assets --recursive", "aws s3 rm s3://prod-assets/old.png", "aws s3 cp ./out s3://site --recursive"]
    },
    {
      "id": "delete-main-branch",
      "where": ["terminal"],
      "pattern": "\\bgit\\s+(?:branch\\s+-D\\s+(?:main|master)\\b|push\\s+\\S+\\s+(?:--delete\\s+|:)(?:main|master)\\b)",
      "title": "That deletes the main branch",
      "message": "If you meant a feature branch, check the name.",
      "urgency": "urgent",
      "positives": ["git branch -D main", "git push origin --delete main", "git push origin :master"],
      "decoys": ["git branch -D feature/voice", "git push origin --delete old-branch", "git checkout main"]
    }
  ]
}
